# Secrets for the Hugging Face Space (API). Copy to deploy/space.env, fill in,
# then either paste each into the Space's Settings -> Variables and secrets, or:
#   python deploy/hf_space.py --space you/udyam-api --env-file deploy/space.env
# deploy/space.env is git-ignored. Never commit it.

ENVIRONMENT=production
# Neon -> your project -> Connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Your Vercel URL (no trailing slash). Add more, comma-separated.
CORS_ORIGINS=https://udyam-digital.vercel.app
# Optional: allow Vercel preview deployments too
CORS_ORIGIN_REGEX=https://udyam-digital-.*\.vercel\.app
PUBLIC_WEB_URL=https://udyam-digital.vercel.app
# Seeds products, 5,000 leads, console accounts and a demo order on first boot
SEED_ON_START=true
CONSOLE_DEMO_PASSWORD=
# OCR runs in the API process; the nightly image purge too
KYC_QUEUE=inline
RUN_PURGE_IN_API=true
# KYC images: "local" keeps them in the container (lost on restart; fine for a demo).
# For persistence use any S3-compatible bucket (Supabase Storage, Cloudflare R2):
STORAGE_BACKEND=local
# S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# S3_BUCKET=kyc-documents
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Optional: smarter advisor (free Gemini key from aistudio.google.com)
GOOGLE_API_KEY=
# Optional: WhatsApp Cloud API test number
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
