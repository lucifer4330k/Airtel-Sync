# Copy to .env and fill in. Never commit .env.

# --- API ---
DATABASE_URL=postgresql+psycopg://udyam:udyam@localhost:5432/udyam
REDIS_URL=redis://localhost:6379/0
# DATA_DIR defaults to <repo>/data; docker compose sets /data
# "Today" for every date-based check (case README says 2026-07-15)
REFERENCE_DATE=2026-07-15
# Fernet key for GSTIN / Udyam column encryption.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000
# Simulated latency of the mock government registries (ms)
MOCK_REGISTRY_MIN_DELAY_MS=300
MOCK_REGISTRY_MAX_DELAY_MS=800

# --- LLM (advisor) ---
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Object storage (KYC documents) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kyc-documents
MINIO_ROOT_USER=udyamminio
MINIO_ROOT_PASSWORD=udyamminio-secret

# --- Payments / WhatsApp (test mode only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
