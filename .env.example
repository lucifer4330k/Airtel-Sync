# Copy to .env and fill in. Never commit .env.

# --- API ---
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and Docker's port
# mapping stalls ~50 s per connection before falling back.
DATABASE_URL=postgresql+psycopg://udyam:udyam@127.0.0.1:5432/udyam
REDIS_URL=redis://127.0.0.1:6379/0
# DATA_DIR defaults to <repo>/data; docker compose sets /data
# "Today" for every date-based check (case README says 2026-07-15)
REFERENCE_DATE=2026-07-15
# Fernet key for GSTIN / Udyam column encryption.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Signs owner links and console sessions. Use the same value on every service.
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000
# Simulated latency of the mock government registries (ms)
MOCK_REGISTRY_MIN_DELAY_MS=300
MOCK_REGISTRY_MAX_DELAY_MS=800

# --- LLM (advisor; optional) ---
# Without a key the advisor runs on its rule-based extractor (fully offline).
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Object storage (KYC documents) ---
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=kyc-documents
S3_ACCESS_KEY=udyam-dev-access
S3_SECRET_KEY=udyam-dev-secret-change-me
# "local" for dev (writes to .storage/), "s3" for the compose object store.
# Files are encrypted with FIELD_ENCRYPTION_KEY before either backend sees them.
STORAGE_BACKEND=local

# --- KYC pipeline ---
# inline: OCR in the API process (dev). rq: queued to the worker (compose, Render).
KYC_QUEUE=inline

# --- Links in WhatsApp messages ---
PUBLIC_WEB_URL=http://localhost:3000

# --- Console ---
# Password for the seeded demo accounts (admin, rep.pune, partner.mumbai, partner.delhi)
CONSOLE_DEMO_PASSWORD=udyam-demo
RATE_LIMIT_ENABLED=true

# --- Payments / WhatsApp (test mode only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=udyam-dev-verify
# Set to verify X-Hub-Signature-256 on inbound webhooks. Without it the webhook
# refuses posts unless WHATSAPP_ALLOW_UNSIGNED=true (local demo only).
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOW_UNSIGNED=false

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
